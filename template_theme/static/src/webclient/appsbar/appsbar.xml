<?xml version="1.0" encoding="UTF-8" ?>
<!-- Template Theme: customize this file for your theme. -->

<templates xml:space="preserve">

    <!-- Template for the Apps Sidebar -->
	<t t-name="template_theme_appsbar.AppsBar">
		<div class="tt_apps_sidebar_panel">
			<div class="tt_apps_sidebar">
				<ul class="tt_apps_sidebar_menu">
                    <!-- Iterate through all available apps -->
				    <t t-foreach="this.appMenuService.getAppsMenuItems()" t-as="app" t-key="app.id">
                        <!-- Highlight the active app -->
			            <li t-attf-class="nav-item {{ app.id === this.appMenuService.getCurrentApp()?.id ? 'active' : '' }}">
			            	<a 
			            		t-att-href="app.href"
		            			t-att-data-menu-id="app.id" 
		            			t-att-data-menu-xmlid="app.xmlid" 
		            			t-att-data-action-id="app.actionID"
								t-on-click.prevent="() => this._onAppClick(app)"
		            			class="nav-link" 
		            			role="menuitem"
		            		>
                                <!-- Display app icon (either custom or default) -->
			                	<img 
			                		class="tt_apps_sidebar_icon" 
			                		t-att-src="getAppIcon(app)"
			                	/>
                                <!-- Display app name -->
						        <span class="tt_apps_sidebar_name">
						            <t t-out="app.label"/>
						        </span>
			            	 </a>
			            </li>
			    	</t>
				</ul>
                <!-- Display company logo at the bottom of the sidebar if configured -->
				<div t-if="sidebarImageUrl" class="tt_apps_sidebar_logo p-2">
					<img class="img-fluid mx-auto" t-att-src="sidebarImageUrl" alt="Logo"/>
				</div>
			</div>
		</div>
	</t>
	
</templates>