<?xml version="1.0" encoding="UTF-8"?>
<!-- Template Theme: customize this file for your theme. -->

<odoo>

    <!-- Inherit the standard Odoo Settings form to add theme customization options -->
	<record id="view_res_config_settings_colors_form" model="ir.ui.view">
	    <field name="name">res.config.settings.form</field>
	    <field name="model">res.config.settings</field>
	    <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
	    <field name="arch" type="xml">
            <!-- Add a new 'Theme Settings' tab after 'General Settings' -->
	    	<xpath expr="//app[@name='general_settings']" position="after">
                <app data-string="Theme Settings" string="Theme Settings" name="template_theme_settings" logo="/template_theme/static/description/icon.png" groups="base.group_user">
                    <block title="Theme" id="template_theme_settings">
                        <!-- Section for customizing core theme colors -->
                        <setting string="Theme Colors" help="Customize the look and feel of the theme">
                            <div class="w-50 row">
                                <label for="theme_color_theme_primary" string="Primary" class="d-block w-75 py-2"/>
                                <field name="theme_color_theme_primary" class="d-block w-25 p-0 m-0" widget="color"/>
                            </div>
                            <div class="w-50 row">
                                <label for="theme_color_theme_background" string="Background" class="d-block w-75 py-2"/>
                                <field name="theme_color_theme_background" class="d-block w-25 p-0 m-0" widget="color"/>
                            </div>
                            <div class="w-50 row">
                                <label for="theme_color_theme_text" string="Text" class="d-block w-75 py-2"/>
                                <field name="theme_color_theme_text" class="d-block w-25 p-0 m-0" widget="color"/>
                            </div>
                            <div class="w-50 row">
                                <label for="theme_color_theme_text_muted" string="Muted Text" class="d-block w-75 py-2"/>
                                <field name="theme_color_theme_text_muted" class="d-block w-25 p-0 m-0" widget="color"/>
                            </div>
                            <div class="w-50 row">
                                <label for="theme_color_theme_text_hover" string="Hover Text" class="d-block w-75 py-2"/>
                                <field name="theme_color_theme_text_hover" class="d-block w-25 p-0 m-0" widget="color"/>
                            </div>
                            <div class="w-50 row">
                                <label for="theme_color_theme_button" string="Button" class="d-block w-75 py-2"/>
                                <field name="theme_color_theme_button" class="d-block w-25 p-0 m-0" widget="color"/>
                            </div>
                            <div class="w-50 row">
                                <label for="theme_color_theme_button_text" string="Button Text" class="d-block w-75 py-2"/>
                                <field name="theme_color_theme_button_text" class="d-block w-25 p-0 m-0" widget="color"/>
                            </div>
                        </setting>

                        <!-- Section for customizing contextual colors (Info, Success, etc.) -->
                        <setting string="Context Colors" help="Customize context colors of the system">
                            <div class="w-50 row">
                                <label for="color_info_light" string="Info" class="d-block w-75 py-2"/>
                                <field name="color_info_light" class="d-block w-25 p-0 m-0" widget="color"/>
                            </div>
                            <div class="w-50 row">
                                <label for="color_success_light" string="Success" class="d-block w-75 py-2"/>
                                <field name="color_success_light" class="d-block w-25 p-0 m-0" widget="color"/>
                            </div>
                            <div class="w-50 row">
                                <label for="color_warning_light" string="Warning" class="d-block w-75 py-2"/>
                                <field name="color_warning_light" class="d-block w-25 p-0 m-0" widget="color"/>
                            </div>
                            <div class="w-50 row">
                                <label for="color_danger_light" string="Danger" class="d-block w-75 py-2"/>
                                <field name="color_danger_light" class="d-block w-25 p-0 m-0" widget="color"/>
                            </div>
                            <!-- Button to reset colors to their default values -->
                            <button
                                name="action_reset_theme_color_assets"
                                icon="oi-arrow-right"
                                type="object"
                                string="Reset Theme Colors"
                                class="btn-link"
                            />
                        </setting>

                        <!-- Section for setting the background image of the apps menu -->
                        <setting
                            string="Background Image"
                            company_dependent="1"
                            help="Set the background image for the apps menu"
                        >
                            <field name="theme_background_image" widget="image" class="ml-4 w-75"/>
                        </setting>

                        <!-- Section for setting the favicon and appsbar logo -->
                        <setting
                            string="Favicon &amp; Logo"
                            company_dependent="1"
                            help="Set your own favicon and logo for the appsbar and login page"
                        >
                            <div class="w-50 row">
                                <label for="appbar_image" string="AppsBar Logo" class="o_light_label mb-1"/>
                                <field name="appbar_image" widget="image" class="ml-4 oe_avatar"/>
                                <div class="w-100 mt-2"/>
                                <label for="login_logo" string="Login Logo" class="o_light_label mb-1"/>
                                <field name="login_logo" widget="image" class="ml-4 oe_avatar"/>
                                <div class="w-100 mt-2"/>
                                <label for="theme_favicon" string="Favicon" class="o_light_label mb-1"/>
                                <field name="theme_favicon" widget="image" class="ml-4 oe_avatar"/>
                            </div>
                        </setting>
                    </block>
                </app>
	    	</xpath>
	    </field>
	</record>
	
</odoo>